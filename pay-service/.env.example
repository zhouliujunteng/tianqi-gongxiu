# 自建微信支付服务所需的环境变量（部署到 Zeabur 时填在服务的 Environment Variables 里）
# 注意：切勿把真实密钥提交到仓库

# 商户号（网页端收款用）
WECHAT_MCH_ID=
# 收款公众号 appid（须与商户号已关联）
WECHAT_APP_ID=wx6e046fecc7bfb0d5
# 微信支付 APIv3 密钥（32 位）
WECHAT_API_V3_KEY=
# 商户 API 证书序列号
WECHAT_SERIAL_NO=
# 商户 API 证书私钥（PEM）。可把换行写成 \n 填这一项，或改用 WECHAT_PRIVATE_KEY_PATH 指定文件路径
WECHAT_PRIVATE_KEY=
# WECHAT_PRIVATE_KEY_PATH=
# 微信支付回调地址（本服务公网地址的 /api/pay/notify）
WECHAT_NOTIFY_URL=
# Zion GraphQL 端点
ZION_GRAPHQL_URL=https://zion-app.functorz.com/zero/bZ7yl9DZ4YY/api/graphql-v2
# CORS 允许的来源，建议填站点域名
ALLOWED_ORIGIN=https://tianqiwushu.cn
# 监听端口（Zeabur 会注入 PORT）
PORT=3000
