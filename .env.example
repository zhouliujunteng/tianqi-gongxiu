VITE_ZION_PROJECT_EX_ID=bZ7yl9DZ4YY

# ---------- 微信登录（二选一思路）----------
# A) Zion 后台若已提供「网页授权 / 微信登录」完整入口 URL，直接粘贴到下面（可用 {REDIRECT} 表示回跳，见下）。
# B) 使用微信开放平台「网站应用」官方授权页（扫码 / 微信内打开）时，可用下面模板（勿漏双引号，否则 #wechat_redirect 会被当成注释）：
#    官方说明：https://developers.weixin.qq.com/doc/oplatform/Website_App/WeChat_Login/Wechat_Login.html
#    构造规则：https://open.weixin.qq.com/connect/qrconnect?appid=APPID&redirect_uri=REDIRECT_URI&response_type=code&scope=snsapi_login&state=STATE#wechat_redirect
#    - 将 APPID 换成开放平台网站应用的 AppID
#    - redirect_uri 填占位符 {REDIRECT}（前端会替换为「当前页 origin+path+query」的 URL 编码，与代码一致）
#    - scope 网站登录填 snsapi_login（不要用公众号网页授权的 snsapi_userinfo 混用）
#    - 不要在 URL 里写死 state=，否则无法拼接邀请人 state；若必须固定 state，需改前端逻辑
#
# 示例（请把 wxYOUR_APPID 换成真实 AppID，整行保留双引号）：
# VITE_ZION_WECHAT_OAUTH_URL="https://open.weixin.qq.com/connect/qrconnect?appid=wxYOUR_APPID&redirect_uri={REDIRECT}&response_type=code&scope=snsapi_login#wechat_redirect"
#
# Zeabur：环境变量里也必须填 VITE_ZION_WECHAT_OAUTH_URL 并重新部署；若留空，旧版会用错误占位 appid 导致「AppID 参数错误」。

VITE_ZION_WECHAT_OAUTH_URL=

# 可选：电脑浏览器内「微信登录」用开放平台 qrconnect（与上面公众号 oauth2 可同时配置）
# VITE_ZION_WECHAT_OAUTH_URL_PC="https://open.weixin.qq.com/connect/qrconnect?appid=wx开放平台AppID&redirect_uri={REDIRECT}&response_type=code&scope=snsapi_login#wechat_redirect"

# ---------- 本地调试（不部署）----------
# 1) 启动：npm run dev（手机同 Wi‑Fi 用终端里 Network 的 http://本机IP:端口/）
# 2) 微信网页授权：回调域名一般不能填 localhost / 局域网 IP，本地通常无法走完整「微信里点授权」；上线用 HTTPS 域名再测。
# 3) 模拟已登录：从 Zion 拿到 JWT 后，浏览器打开：
#    http://localhost:5173/?token=粘贴JWT   （端口以终端为准；也支持 #/... 或 ?jwt=）
#    保存后会清掉地址栏参数，再走 account 查询，与线上一致。
# 4) 只测问卷 UI：登录页点「暂不登录，先进入问卷」。

# ---------- 问卷页 · 微信支付（Zion 专业版支付能力）----------
# 开启且要求支付时：登录后会查 fz_payment_record（当前 account_id、status=SUCCESSFUL）
#（订单类型「2026引流问卷」且订单状态「已支付」）；任一满足即允许提交，否则展示微信支付卡片。
# 默认：GraphQL insert 订单表 ud_dingdan_b6a218（未支付，用户库外键列 ud_yonghuxinxi_yonghuku_55773d 为 null），再用订单 id 调 createWechatPayment。详见：https://docs.functorz.com/actions/payment/
# 若小程序里支付前是用「行为流」单独建单（金额在行为流里写入支付绑定订单表），网页端应走同一行为流，避免与小程序两套建单逻辑不一致或 total_fee 读错列：
#   VITE_WENJUAN_ORDER_CREATE_ACTION_FLOW_ID=行为流 UUID（与小程序调用的 id 一致）
#   VITE_WENJUAN_ORDER_CREATE_ACTION_FLOW_VERSION_ID=-1
#   可选 VITE_WENJUAN_ORDER_CREATE_FLOW_ARGS_JSON={"你的静态入参":"值"}  （会与 amount_yuan、amount_fen、order_type、description、wenjuan_tag、account_id 合并，后者覆盖同名键）
#   若行为流返回的订单 id 字段名特殊：VITE_WENJUAN_ORDER_CREATE_FLOW_ORDER_ID_KEY=dingdan_id
# 订单金额(小数) ud_dingdanjine_a50087 为 DECIMAL；仍报 JSAPI 缺少 total_fee 时，在 Zion 支付设置核对「订单金额」绑定列与行为流/insert 写入列一致。
# VITE_WENJUAN_PAY_ENABLED=1
# VITE_WENJUAN_PAY_REQUIRE_SUBMIT=0
# VITE_WENJUAN_PAY_AMOUNT_YUAN=29.9
# VITE_WENJUAN_PAY_DESCRIPTION=问卷收集服务费
# 若 GraphQL 报错 PaymentType，可显式指定。本仓库默认：微信内 WECHATPAY_MINIPROGRAM，外置手机浏览器 WECHATPAY_MOBILE_WEB（以你项目 GraphQL 枚举为准）
# VITE_WECHAT_PAYMENT_TYPE=
# 已付费资格查询 fz_payment_record 时，type 须命中其一（逗号分隔）。默认已含 H5+小程序 JSAPI 两种
# VITE_WENJUAN_PAY_ELIGIBILITY_TYPES=WECHATPAY_MOBILE_WEB,WECHATPAY_MINIPROGRAM
# 微信 total_fee 须为整数分。若 Zion 未把 createWechatPayment 的「元」换算为分导致 JSAPI 报错，设 1 让 amount 传分（如 2990）；后端已按元处理时不要开
# VITE_WENJUAN_CREATE_WECHAT_PAY_AMOUNT_AS_FEN=1
# 1=createWechatPayment 的 amount 用 "29.90" 字符串（BigDecimal 序列化）
# VITE_WENJUAN_CREATE_WECHAT_PAY_AMOUNT_AS_YUAN_STRING=1
# 1=GraphQL insert 订单后再 update_by_pk 写一次金额列（订单金额未落库时试）
# VITE_WENJUAN_ORDER_AMOUNT_PATCH_AFTER_INSERT=1
# 控制台打印支付相关 GraphQL variables / 响应（排查 total_fee 等）。未设置：仅开发服打印；=1 生产也打印；=0 全关
# VITE_WENJUAN_PAY_LOG_REQUESTS=1

# ---------- 共修营第三期 · 微信添加管理 ----------
# 老师账号 ID（逗号分隔），登录后可进入「微信添加管理」页，查看第三期已支付学员微信号并标记是否已添加
# VITE_CAMP_WECHAT_ADMIN_ACCOUNT_IDS=1000000000000000
